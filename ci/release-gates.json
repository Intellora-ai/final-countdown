{
  "workflow": ".github/workflows/ci.yml",
  "required_jobs": [
    "integrity",
    "core",
    "browser",
    "container",
    "security"
  ],
  "commands": {
    "integrity": [
      "python3 ci/check_workflows.py",
      "python3 -m unittest discover -s ci/tests",
      "python3 ci/install_actionlint.py",
      ".ci-tools/actionlint -color"
    ],
    "core": [
      "npm ci",
      "npm run test:ci",
      "npm run test:strength",
      "npm run build",
      "npm run test:production",
      "npm audit --audit-level=moderate"
    ],
    "browser": [
      "npm ci",
      "npm run build",
      "npx --no-install playwright install --with-deps chromium",
      "TEST_PRODUCTION=1 npm run test:e2e -- --fail-on-flaky-tests",
      "npm run test:e2e -- tests/browser/learning.spec.ts --fail-on-flaky-tests"
    ],
    "container": [
      "docker build -t canvas-ci .",
      "node frontend/scripts/check-container.mjs canvas-ci"
    ],
    "security": [
      "python3 ci/check_sarif.py codeql-results"
    ],
    "release-gate": [
      "python3 ci/check_verdict.py"
    ]
  },
  "npm_scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:e2e": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "test:strength": "node scripts/check-test-strength.mjs && python3 ../ci/check_mutations.py test-results/mutations.json .",
    "test:ci": "vitest run --maxWorkers=4 --coverage --reporter=default --reporter=json --outputFile=test-results/unit.json && node scripts/check-test-results.mjs"
  },
  "test_floors": { "tests": 270, "files": 21 },
  "coverage_floors": {
    "lines": 85,
    "statements": 80,
    "functions": 79,
    "branches": 76
  }
}
