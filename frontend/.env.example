# The environment the almanac server (frontend/dist-server/index.js) actually
# reads. Names and meanings only — never a real value, token, or key in this
# file. Verified against frontend/server/index.ts, not assumed.
#
# On Railway these become the service's Variables. Locally, the server reads
# process.env directly (it does not load a .env file itself), so export them or
# put them on the command line.

# ── Network ──────────────────────────────────────────────────────────────────
# The port to listen on. Railway injects PORT automatically — do NOT set it
# there. Locally, defaults to 8787 when unset.
PORT=
# The interface to bind. MUST be 0.0.0.0 on any host whose proxy reaches the
# container from outside (Railway). The Dockerfile already sets this; a bare
# `node dist-server/index.js` on a laptop defaults to 127.0.0.1 (loopback).
HOST=

# ── The model that authors lessons (REQUIRED in production) ──────────────────
# Without a hosted model key the server still serves the app and /api/health,
# but cannot author a lesson — asking a question returns nothing. Ollama is
# local-only and cannot run on Railway, so a hosted key is required in prod.
# Groq has a free tier (console.groq.com): set ONE of these.
GROQ_API_KEY=
# Any one of these hosted providers works instead of Groq; the server picks
# whichever is present (see chooseProvider). Each also takes <NAME>_MODEL and
# <NAME>_BASE_URL to change the model or use a regional endpoint.
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ── Identity (who a returning student is) ────────────────────────────────────
# The secret that signs a student's identity cookie. Set this to a long random
# string in production so identity is stable across restarts and replicas.
# If unset, the server generates one into ALMANAC_IDENTITY_SECRET_FILE — safe
# for ONE machine only.
ALMANAC_IDENTITY_SECRET=
# Where the generated secret is kept when ALMANAC_IDENTITY_SECRET is unset. Put
# it on the mounted volume so it survives a redeploy. Default: data/identity-secret.
ALMANAC_IDENTITY_SECRET_FILE=
# Set to 1 (or true/yes) to plant the cookie with `Secure`. REQUIRED behind
# https (Railway serves https). Leave unset on a plain-http laptop, where a
# Secure cookie is dropped and every request would mint a new student.
IDENTITY_COOKIE_SECURE=

# ── Where a student's work is stored ─────────────────────────────────────────
# The sqlite file holding canvas memory. Put it on a mounted volume so a
# student's work survives a redeploy. Default: data/canvas-memory.db.
CANVAS_MEMORY_DB=
# The almanac ledger. A JSON file by default (put it on the volume too), OR set
# ALMANAC_DATABASE_URL below to keep the ledger in Postgres instead.
ALMANAC_LEDGER=
# Optional: a Postgres connection string (e.g. a Neon or Railway Postgres URL).
# When set, the ledger lives in Postgres — shared and safe for many servers —
# and ALMANAC_LEDGER is ignored.
ALMANAC_DATABASE_URL=

# ── Serving the built frontend ───────────────────────────────────────────────
# Optional override for the directory of the built Vite app the server serves
# at /. Defaults to the dist/ next to the server bundle, which is correct for
# both the Docker image and a local `node dist-server/index.js` — set this only
# on a host that lays the files out differently.
STATIC_DIR=

# ── Grounding: where lessons get their sources ───────────────────────────────
# A URL TEMPLATE. `{query}` and `{limit}` are substituted per request; `{key}`,
# when present, is filled from WEB_SEARCH_API_KEY so the credential is never
# written here. `openweb.ts` accepts any provider returning `{ results: [...] }`.
#
# WHY THIS MATTERS MORE THAN IT LOOKS. Unset, the server still starts and still
# answers — every lesson is simply written from the model's memory alone, and
# the log says `0 source(s) from 0 domain(s)` once per request. For a product
# whose rule is "never answer without a real source", that is the difference
# between the product and something that resembles it. The startup banner now
# prints `search: none` so this cannot pass unnoticed.
#
# FREE AND KEYLESS, LOCALLY: `docker compose -f docker-compose.search.yml up
# searxng` gives dozens of engines with no account, and the template is then:
#   WEB_SEARCH_ENDPOINT=http://127.0.0.1:8080/search?q={query}&format=json
WEB_SEARCH_ENDPOINT=
# Only for providers that authenticate by query parameter or header; SearxNG
# needs none. See `authHeaders` in openweb.ts.
WEB_SEARCH_API_KEY=

# ── The intelligence layer ───────────────────────────────────────────────────
# `off` (the default), `shadow`, or `canary`.
#
# The sixteen modules under server/intelligence/ are compiled into the shipped
# server and reached on every POST /api/ask, then stop at one check:
# `shadow.ts` returns immediately while this is `off`. So the layer costs
# nothing and does nothing until an operator sets this.
#
#   shadow  — the second opinion is computed and recorded beside the answer the
#             learner already got. Nothing she sees changes. Costs model calls.
#   canary  — it answers for INTELLIGENCE_CANARY_PERCENT of requests.
#
# Promotion is deliberate: a person sets this and the percentage. See canary.ts.
INTELLIGENCE_MODE=
INTELLIGENCE_CANARY_PERCENT=
