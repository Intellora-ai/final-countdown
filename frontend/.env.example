# Server-only configuration. Never use VITE_ for model credentials.
# Full OpenAI-compatible chat-completions URL, e.g. a local Ollama endpoint.
LESSON_API_URL=http://127.0.0.1:11434/v1/chat/completions
# Set this to a model actually available from the endpoint.
LESSON_MODEL=
# Hosted services may require this. Enter it securely, never in source control.
LESSON_API_KEY=
LESSON_CONTEXT=8192
# Optional search adapter. It must return { results: [{ title, url, snippet }] }.
SEARCH_API_URL=
SEARCH_API_KEY=
