# Server-only configuration. Never use VITE_ for credentials.
LESSON_API_URL=http://127.0.0.1:11434/v1/chat/completions
LESSON_MODEL=
LESSON_API_KEY=
# Groq uses json_object; default is json_schema for providers supporting it.
LESSON_RESPONSE_FORMAT=json_schema
LESSON_MAX_TOKENS=4096
# Required only for production. Supply a random password of at least 16 characters.
CANVAS_ACCESS_PASSWORD=
CANVAS_DAILY_REQUESTS=100
# Production needs persistent writable storage; Docker uses /app/state.
CANVAS_STATE_DIR=.canvas-state
