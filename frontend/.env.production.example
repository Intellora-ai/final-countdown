# ─────────────────────────────────────────────────────────────────────────────
#  PRODUCTION TEMPLATE.  Copy to `.env.production`, then fill it in.
#
#  EVERY `VITE_` VALUE IS PUBLIC, and in production it is public to the whole
#  internet. Vite compiles these into the bundle every visitor downloads.
#  Secrets belong in the SERVER's environment. Nothing in this file is secret.
# ─────────────────────────────────────────────────────────────────────────────

# WHERE THE BACKEND IS.  Required here: the built app is served as static files,
# so there is no dev proxy to fall back on. Point it at the origin running
# `server/index.ts`. No trailing path -- `/api/ask` is appended.
VITE_API_BASE=https://api.almanac.example.org

# WEB SEARCH.  Blank means the tutor says it cannot look things up. That is the
# honest state, and better than answers with invented sources.
VITE_SEARCH_ENDPOINT=
VITE_SEARCH_DEPTH=

# --- THESE STAY EMPTY, ALWAYS ------------------------------------------------
# A key here is published to every visitor. The backend holds the real one:
#     GROQ_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY in the SERVER process.
VITE_TUTOR_KEY=
VITE_SEARCH_KEY=
