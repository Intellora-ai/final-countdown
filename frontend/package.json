{
  "name": "visual-learning-canvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:e2e": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "test:strength": "node scripts/check-test-strength.mjs",
    "test:ci": "vitest run --maxWorkers=4 --coverage --reporter=default --reporter=json --outputFile=test-results/unit.json && node scripts/check-test-results.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.5.4",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
