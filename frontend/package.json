{
  "name": "learning-os-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.canvas.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.canvas.json --pretty false && tsc --noEmit -p tsconfig.server.json --pretty false",
    "test": "vitest",
    "test:mutation": "node scripts/mutation-gate.mjs",
    "budget": "node scripts/canvas-bundle-budget.mjs",
    "gate:reachability": "node scripts/reachability-gate.mjs --product",
    "lint": "eslint src/canvas src/practice src/agent src/websearch src/tutor src/almanac src/api --max-warnings 0",
    "curriculum:fetch": "node scripts/curriculum/fetch.mjs",
    "curriculum:verify": "node scripts/curriculum/fetch.mjs --verify",
    "curriculum:extract": "node scripts/curriculum/extract-all.mjs",
    "curriculum:build": "node scripts/curriculum/build.mjs",
    "server": "npm run server:build && node dist-server/index.js",
    "gate:secrets": "node scripts/secret-exposure-gate.mjs",
    "server:build": "vite build --config vite.server.config.ts",
    "exams:build": "node scripts/curriculum/build-exams.mjs",
    "gate:eval": "vitest run src/websearch/evalGate.test.ts",
    "probe:ollama": "vitest run --config vitest.probe.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@visx/scale": "^4.0.0",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "three": "^0.169.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@pact-foundation/pact": "17.1.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.0",
    "fast-check": "4.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
