{
  "name": "learning-os-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.canvas.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.canvas.json --pretty false",
    "test": "vitest",
    "test:mutation": "node scripts/mutation-gate.mjs",
    "budget": "node scripts/canvas-bundle-budget.mjs",
    "gate:reachability": "node scripts/reachability-gate.mjs",
    "lint": "eslint src/canvas src/practice src/agent src/websearch --max-warnings 0"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@visx/scale": "^4.0.0",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.169.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
