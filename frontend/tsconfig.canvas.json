{
  /*
   * A SECOND, STRICTER PASS OVER THE CANVAS ONLY.
   *
   * This is not how the canvas gets `strict` — it gets that from
   * `tsconfig.json`, which turns it on for the whole package because zod's
   * inference collapses without strictNullChecks (the reasoning is written out
   * there). A second project could not have provided it: `exclude` filters only
   * the ROOT file list, and `App.tsx` imports the canvas, so the compiler
   * follows it in and checks it under the ENTRY project's settings regardless.
   *
   * What this config adds is one flag the dashboard is not ready for.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /*
     * `noUncheckedIndexedAccess` came with this code from the standalone
     * engine. It makes `blocks[i]` read as possibly-undefined, and several
     * guards in `layout.ts` and the shape modules exist only because it does.
     * Running without it would not break the build — it would quietly retire
     * those guards' reason for existing, and the next person to touch them
     * would find them arbitrary and delete them.
     *
     * It stays scoped here because switching it on package-wide would light up
     * the dashboard, which is out of scope for this work.
     */
    "noUncheckedIndexedAccess": true
  },
  /* `src/vite-env.d.ts` is named explicitly: narrowing `include` to one
   * directory also drops the package's ambient declarations, and the shape
   * tests import their own source with Vite's `?raw` suffix. */
  "include": ["src/canvas", "src/vite-env.d.ts", "src/node-fs.d.ts"]
}
