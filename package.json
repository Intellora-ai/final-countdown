{
  "name": "final-countdown",
  "version": "1.0.0",
  "description": "Learning OS. Every function in src/ carries a Lean 4 specification kernel-checked by AXLE; the rest is gated by coverage, mutation and type checks.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:canvas": "cd frontend && npx playwright test",
    "test:canvas:headed": "cd frontend && npx playwright test --headed",
    "test:sauce": "node scripts/sauce-preflight.mjs && saucectl run --config .sauce/config.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intellora-ai/final-countdown.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Intellora-ai/final-countdown/issues"
  },
  "homepage": "https://github.com/Intellora-ai/final-countdown#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "saucectl": "^0.213.0"
  }
}
